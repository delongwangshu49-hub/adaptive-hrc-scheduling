      "required": [
        "person_id",
        "fatigue",
        "exposure",
        "peak",
        "rest_until_h"
      ],
      "type": "object"
    },
    "InputReadback": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
