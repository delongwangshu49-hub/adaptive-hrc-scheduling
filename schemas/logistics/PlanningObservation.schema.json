        },
        "converted": {
          "minimum": 0,
          "type": "number"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "identified": {
          "type": "boolean"
        },
        "location": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "released": {
          "type": "boolean"
        },
        "returned": {
          "minimum": 0,
