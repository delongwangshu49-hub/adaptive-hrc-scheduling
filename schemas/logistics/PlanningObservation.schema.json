{
  "$comment": "Structural schema only. Python semantic validation is mandatory.",
  "$defs": {
    "DispatchCommand": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "attempt": {
          "minimum": 0,
          "type": "integer"
        },
        "config_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "type": "integer"
        },
        "expected_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "issued_sim_h": {
          "minimum": 0,
          "type": "number"
        },
        "mode_id": {
          "enum": [
            "H",
            "H-team",
            "MOVE",
            "WAIT",
            "GATE"
          ]
        },
        "operation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "resume_of": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleBinding"
          },
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "S14-ML-1.0"
          ]
        },
        "unit_index": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "config_id",
        "config_sha256",
        "run_id",
        "epoch",
        "id",
        "product_id",
        "activity_id",
        "operation_id",
        "attempt",
        "unit_index",
        "mode_id",
        "issued_sim_h",
        "expected_revision",
        "roles",
        "resume_of"
      ],
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "occurred_sim_h": {
          "minimum": 0,
          "type": "number"
        },
        "product_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "revision": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "product_id",
        "attempt",
        "result",
        "occurred_sim_h",
        "revision"
      ],
      "type": "object"
    },
    "HumanInterval": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_f": {
          "minimum": 0,
          "type": "number"
        },
        "end_h": {
          "minimum": 0,
          "type": "number"
        },
        "exposure": {
          "minimum": 0,
          "type": "number"
        },
        "person_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "phase": {
          "enum": [
            "WALK",
            "DRIVE",
            "PUSH",
            "SETUP",
            "WORK",
            "SUPERVISE",
            "WAIT",
            "REST",
            "OFF_SHIFT",
            "EMERGENCY_HOLD"
          ]
        },
        "rate": {
          "minimum": 0,
          "type": "number"
        },
        "start_f": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "start_h": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "person_id",
        "command_id",
        "start_h",
        "end_h",
        "phase",
        "rate",
        "start_f",
        "end_f",
        "exposure"
      ],
      "type": "object"
    },
    "HumanState": {
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "minimum": 0,
          "type": "number"
        },
        "fatigue": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "peak": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "person_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "rest_until_h": {
          "minimum": 0,
          "type": "number"
        }
