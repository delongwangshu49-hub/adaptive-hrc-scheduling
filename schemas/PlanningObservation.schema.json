{
  "$comment": "Structural schema only. Python semantic validation is mandatory.",
  "$defs": {
    "Estimate": {
      "additionalProperties": false,
      "properties": {
        "available_estimate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "exposure_estimate_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "fatigue_estimate": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_min": {
          "minimum": 0,
          "type": "number"
        },
        "resource_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "sampled_min": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "resource_id",
        "sampled_min",
        "received_min",
        "fatigue_estimate",
        "exposure_estimate_min",
        "available_estimate"
      ],
      "type": "object"
    },
    "KnownOrder": {
      "additionalProperties": false,
      "properties": {
        "actual_completion_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel_observed_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_observed_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "order_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "released_observed_min": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "order_id",
        "released_observed_min",
        "cancel_observed_min",
        "completion_observed_min",
        "actual_completion_min"
      ],
      "type": "object"
    },
    "PlanningObservation": {
      "additionalProperties": false,
      "properties": {
        "as_of_min": {
          "minimum": 0,
          "type": "number"
        },
        "configuration_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "estimates": {
          "items": {
            "$ref": "#/$defs/Estimate"
          },
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "planning_observation"
          ]
        },
        "known_orders": {
          "items": {
            "$ref": "#/$defs/KnownOrder"
          },
          "type": "array"
        },
        "observed_event_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "S06-1.0"
          ]
        },
        "units": {
          "$ref": "#/$defs/Units"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "run_id",
        "configuration_id",
        "units",
        "as_of_min",
        "known_orders",
        "estimates",
        "observed_event_ids"
      ],
      "type": "object"
    },
    "Units": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "enum": [
            "count"
          ]
        },
        "exposure": {
          "enum": [
            "min"
          ]
        },
        "fatigue": {
          "enum": [
            "dimensionless"
          ]
        },
        "rate": {
          "enum": [
            "min^-1"
          ]
        },
        "time": {
          "enum": [
            "min"
          ]
        }
      },
      "required": [
        "time",
        "rate",
        "fatigue",
        "exposure",
        "capacity"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/PlanningObservation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningObservation"
}
