{
  "$comment": "Structural schema only. Python semantic validation is mandatory.",
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "allocation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "group_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "group_id",
        "allocation_id"
      ],
      "type": "object"
    },
    "Estimate": {
      "additionalProperties": false,
      "properties": {
        "available_estimate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "exposure_estimate_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "fatigue_estimate": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_min": {
          "minimum": 0,
          "type": "number"
        },
        "resource_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "sampled_min": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "resource_id",
        "sampled_min",
        "received_min",
        "fatigue_estimate",
        "exposure_estimate_min",
        "available_estimate"
      ],
      "type": "object"
    },
    "KnownOrder": {
      "additionalProperties": false,
      "properties": {
        "actual_completion_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel_observed_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_observed_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "order_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "released_observed_min": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "order_id",
        "released_observed_min",
        "cancel_observed_min",
        "completion_observed_min",
        "actual_completion_min"
      ],
      "type": "object"
    },
    "Lock": {
      "additionalProperties": false,
      "properties": {
        "owner_group_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "active",
            "held",
            "reserved",
            "occupied"
          ]
        },
        "resource_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "owner_group_id",
        "purpose"
      ],
      "type": "object"
    },
    "MaterialPosition": {
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "slot": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "stored",
            "in_transit",
            "consumed",
            "scrapped",
            "finished"
          ]
        }
      },
      "required": [
        "material_id",
        "location_id",
        "status",
        "slot"
      ],
      "type": "object"
    },
    "ObservedExecution": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "type": "array"
        },
        "locks": {
          "items": {
            "$ref": "#/$defs/Lock"
          },
          "type": "array"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/MaterialPosition"
          },
          "type": "array"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/PhaseState"
          },
          "type": "array"
        },
        "preparations": {
          "items": {
            "$ref": "#/$defs/Preparation"
          },
          "type": "array"
        },
        "received_min": {
          "minimum": 0,
          "type": "number"
        },
        "reservations": {
          "items": {
            "$ref": "#/$defs/Reservation"
          },
          "type": "array"
        },
        "sampled_min": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "sampled_min",
        "received_min",
        "bindings",
        "phases",
        "locks",
        "materials",
        "reservations",
        "preparations"
      ],
      "type": "object"
    },
    "PhaseState": {
      "additionalProperties": false,
      "properties": {
        "allocation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "attempt": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "completed_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "group_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "mode_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "phase_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "remaining_base_min": {
          "minimum": 0,
          "type": "number"
        },
        "restore_sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "sampled_f": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "speed_multiplier": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "started_min": {
          "minimum": 0,
          "type": "number"
        },
        "status": {
          "enum": [
            "running",
            "paused",
            "completed",
            "failed"
          ]
        }
      },
      "required": [
        "operation_id",
        "mode_id",
        "allocation_id",
        "group_id",
        "phase_id",
        "attempt",
        "restore_sequence",
        "status",
        "remaining_base_min",
        "sampled_f",
        "speed_multiplier",
        "started_min",
        "completed_min"
      ],
      "type": "object"
    },
    "PlanningObservation": {
      "additionalProperties": false,
      "properties": {
        "as_of_min": {
          "minimum": 0,
          "type": "number"
        },
        "configuration_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "estimates": {
          "items": {
            "$ref": "#/$defs/Estimate"
          },
          "type": "array"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedExecution"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "planning_observation"
          ]
        },
        "known_orders": {
          "items": {
            "$ref": "#/$defs/KnownOrder"
          },
          "type": "array"
        },
        "observed_event_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "S06-1.1"
          ]
        },
        "units": {
          "$ref": "#/$defs/Units"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "run_id",
        "configuration_id",
        "units",
        "as_of_min",
        "known_orders",
        "estimates",
        "observed_event_ids",
        "execution"
      ],
      "type": "object"
    },
    "Preparation": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "robot_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "station_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "robot_id",
        "operation_id",
        "group_id",
        "station_id",
        "valid"
      ],
      "type": "object"
    },
    "Reservation": {
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "owner_group_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "slot": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "material_id",
        "location_id",
        "owner_group_id",
        "slot"
      ],
      "type": "object"
    },
    "Units": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "enum": [
            "count"
          ]
        },
        "exposure": {
          "enum": [
            "min"
          ]
        },
        "fatigue": {
          "enum": [
            "dimensionless"
          ]
        },
        "rate": {
          "enum": [
            "min^-1"
          ]
        },
        "time": {
          "enum": [
            "min"
          ]
        }
      },
      "required": [
        "time",
        "rate",
        "fatigue",
        "exposure",
        "capacity"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/PlanningObservation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningObservation"
}
