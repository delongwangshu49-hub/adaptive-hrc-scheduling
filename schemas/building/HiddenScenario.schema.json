{
  "$comment": "Structural schema only. Python semantic validation is mandatory.",
  "$defs": {
    "HiddenScenario": {
      "additionalProperties": false,
      "properties": {
        "config_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/WorldEvent"
          },
          "type": "array"
        },
        "schema_version": {
          "enum": [
            "C04-1.0"
          ]
        },
        "seed": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "config_id",
        "seed",
        "events"
      ],
      "type": "object"
    },
    "WorldEvent": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "MATERIAL_ARRIVAL",
            "MATERIAL_IDENTIFY",
            "MATERIAL_RELEASE",
            "PROCESS_RELEASE",
            "QUALITY_RESULT",
            "INVALIDATE",
            "FAILURE",
            "REPAIR",
            "ORDER_ARRIVAL",
            "CANCEL",
            "RECEIVED"
          ]
        },
        "time_h": {
          "minimum": 0,
          "type": "number"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "time_h",
        "kind",
        "entity_id",
        "value",
        "attempt"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/HiddenScenario",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HiddenScenario"
}
