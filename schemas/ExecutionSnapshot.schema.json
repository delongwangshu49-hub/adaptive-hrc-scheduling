{
  "$comment": "Structural schema only. Python semantic validation is mandatory.",
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "allocation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "group_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "group_id",
        "allocation_id"
      ],
      "type": "object"
    },
    "ExecutionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "type": "array"
        },
        "configuration_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "execution_snapshot"
          ]
        },
        "locks": {
          "items": {
            "$ref": "#/$defs/Lock"
          },
          "type": "array"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/MaterialPosition"
          },
          "type": "array"
        },
        "orders": {
          "items": {
            "$ref": "#/$defs/OrderState"
          },
          "type": "array"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/PhaseState"
          },
          "type": "array"
        },
        "preparations": {
          "items": {
            "$ref": "#/$defs/Preparation"
          },
          "type": "array"
        },
        "reservations": {
          "items": {
            "$ref": "#/$defs/Reservation"
          },
          "type": "array"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceState"
          },
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "S06-1.1"
          ]
        },
        "sim_time_min": {
          "minimum": 0,
          "type": "number"
        },
        "units": {
          "$ref": "#/$defs/Units"
        },
        "workers": {
          "items": {
            "$ref": "#/$defs/WorkerState"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "configuration_id",
        "units",
        "sim_time_min",
        "workers",
        "preparations",
        "bindings",
        "phases",
        "locks",
        "materials",
        "reservations",
        "resources",
        "orders"
      ],
      "type": "object"
    },
    "Lock": {
      "additionalProperties": false,
      "properties": {
        "owner_group_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "active",
            "held",
            "reserved",
            "occupied"
          ]
        },
        "resource_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "owner_group_id",
        "purpose"
      ],
      "type": "object"
    },
    "MaterialPosition": {
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "slot": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "stored",
            "in_transit",
            "consumed",
            "scrapped",
            "finished"
          ]
        }
      },
      "required": [
        "material_id",
        "location_id",
        "status",
        "slot"
      ],
      "type": "object"
    },
    "OrderState": {
      "additionalProperties": false,
      "properties": {
        "actual_completion_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancelled": {
          "type": "boolean"
        },
        "order_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "released": {
          "type": "boolean"
        }
      },
      "required": [
        "order_id",
        "released",
        "cancelled",
        "actual_completion_min"
      ],
      "type": "object"
    },
    "PhaseState": {
      "additionalProperties": false,
      "properties": {
        "allocation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "attempt": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "completed_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "group_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "mode_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "phase_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "remaining_base_min": {
          "minimum": 0,
          "type": "number"
        },
        "restore_sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "sampled_f": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "speed_multiplier": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "started_min": {
          "minimum": 0,
          "type": "number"
        },
        "status": {
          "enum": [
            "running",
            "paused",
            "completed",
            "failed"
          ]
        }
      },
      "required": [
        "operation_id",
        "mode_id",
        "allocation_id",
        "group_id",
        "phase_id",
        "attempt",
        "restore_sequence",
        "status",
        "remaining_base_min",
        "sampled_f",
        "speed_multiplier",
        "started_min",
        "completed_min"
      ],
      "type": "object"
    },
    "Preparation": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "robot_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "station_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "robot_id",
        "operation_id",
        "group_id",
        "station_id",
        "valid"
      ],
      "type": "object"
    },
    "Reservation": {
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "owner_group_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "slot": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "material_id",
        "location_id",
        "owner_group_id",
        "slot"
      ],
      "type": "object"
    },
    "ResourceState": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "type": "boolean"
        },
        "release_allowed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "failed",
        "release_allowed"
      ],
      "type": "object"
    },
    "Units": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "enum": [
            "count"
          ]
        },
        "exposure": {
          "enum": [
            "min"
          ]
        },
        "fatigue": {
          "enum": [
            "dimensionless"
          ]
        },
        "rate": {
          "enum": [
            "min^-1"
          ]
        },
        "time": {
          "enum": [
            "min"
          ]
        }
      },
      "required": [
        "time",
        "rate",
        "fatigue",
        "exposure",
        "capacity"
      ],
      "type": "object"
    },
    "WorkerState": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "enum": [
            "work",
            "collaborate",
            "carry",
            "supervise",
            "wait",
            "rest"
          ]
        },
        "exposure_min": {
          "minimum": 0,
          "type": "number"
        },
        "fatigue": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "worker_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "worker_id",
        "fatigue",
        "exposure_min",
        "activity"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/ExecutionSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionSnapshot"
}
