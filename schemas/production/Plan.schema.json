{
  "$comment": "Structural schema only. Python semantic validation is mandatory.",
  "$defs": {
    "Amount": {
      "additionalProperties": false,
      "properties": {
        "lot_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "lot_id",
        "quantity"
      ],
      "type": "object"
    },
    "ComponentPort": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "place_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "place_id"
      ],
      "type": "object"
    },
    "DispatchCommand": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "attempt": {
          "minimum": 0,
          "type": "integer"
        },
        "config_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "type": "integer"
        },
        "expected_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "issued_sim_h": {
          "minimum": 0,
          "type": "number"
        },
        "mode_id": {
          "enum": [
            "H",
            "H-team",
            "MOVE",
            "WAIT",
            "GATE"
          ]
        },
        "operation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "resume_of": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleBinding"
          },
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "S15-PROD-1.0"
          ]
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/Service"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_index": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "config_id",
        "config_sha256",
        "run_id",
        "epoch",
        "id",
        "product_id",
        "activity_id",
        "operation_id",
        "attempt",
        "unit_index",
        "mode_id",
        "issued_sim_h",
        "expected_revision",
        "roles",
        "resume_of",
        "service"
      ],
      "type": "object"
    },
    "MaterialPort": {
      "additionalProperties": false,
      "properties": {
        "lot_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "place_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "lot_id",
        "place_id"
      ],
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "WALK",
            "TRANSFER",
            "EMPTY_RETURN",
            "RESERVE",
            "RELEASE_RESERVATION",
            "CONVERT",
            "WORK",
            "READY",
            "RECEIVE_EXTERNAL",
            "RETURN",
            "SCRAP",
            "REST",
            "DEPLOY_TOOL",
            "RETRIEVE_TOOL",
            "SUPPORT_CHANGE"
          ]
        },
        "activity_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "attempt_index": {
          "minimum": 0,
          "type": "integer"
        },
        "base_h": {
          "minimum": 0,
          "type": "number"
        },
        "component_input_places": {
          "items": {
            "$ref": "#/$defs/ComponentPort"
          },
          "type": "array"
        },
        "component_inputs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "component_outputs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "entity_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "equipment": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "hold_device": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "input_places": {
          "items": {
            "$ref": "#/$defs/MaterialPort"
          },
          "type": "array"
        },
        "kappa": {
          "minimum": 0,
          "type": "number"
        },
        "location": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "mass_remove_t": {
          "minimum": 0,
          "type": "number"
        },
        "material_inputs": {
          "items": {
            "$ref": "#/$defs/Amount"
          },
          "type": "array"
        },
        "material_outputs": {
          "items": {
            "$ref": "#/$defs/Amount"
          },
          "type": "array"
        },
        "output_places": {
          "items": {
            "$ref": "#/$defs/MaterialPort"
          },
          "type": "array"
        },
        "phase": {
          "enum": [
            "WALK",
            "DRIVE",
            "PUSH",
            "SETUP",
            "WORK",
            "SUPERVISE",
            "REST"
          ]
        },
        "prerequisites": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "product_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "production_mode": {
          "anyOf": [
            {
              "enum": [
                "H",
                "H-team",
                "MOVE",
                "WAIT",
                "GATE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "quality_gates": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "release_device": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "role_locations": {
          "items": {
            "$ref": "#/$defs/PersonPosition"
          },
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/Role"
          },
          "type": "array"
        },
        "route_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "scrap_quantity": {
          "minimum": 0,
          "type": "number"
        },
        "support_layout_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_index": {
          "minimum": 0,
          "type": "integer"
        },
        "wait_after": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_gate": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_h": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "product_id",
        "activity_id",
        "action",
        "phase",
        "prerequisites",
        "roles",
        "role_locations",
        "equipment",
        "location",
        "target",
        "route_id",
        "entity_id",
        "material_inputs",
        "material_outputs",
        "scrap_quantity",
        "base_h",
        "kappa",
        "qualification_ids",
        "quality_gates",
        "wait_gate",
        "hold_device",
        "release_device",
        "component_inputs",
        "component_outputs",
        "attempt_index",
        "unit_index",
        "input_places",
        "output_places",
        "production_mode",
        "wait_after",
        "wait_h",
        "mass_remove_t",
        "component_input_places",
        "support_layout_id"
      ],
      "type": "object"
    },
    "PersonPosition": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "person_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "person_id",
        "location"
      ],
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "$ref": "#/$defs/DispatchCommand"
          },
          "type": "array"
        },
        "config_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "S15-PROD-1.0"
          ]
        },
        "status": {
          "enum": [
            "CANDIDATE",
            "WAIT",
            "NO_PLAN_FOUND"
          ]
        }
      },
      "required": [
        "schema_version",
        "config_id",
        "observation_id",
        "commands",
        "status",
        "reason"
      ],
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "type": "object"
    },
    "Role": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "qualification": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "qualification"
      ],
      "type": "object"
    },
    "RoleBinding": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "role_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        }
      },
      "required": [
        "role_id",
        "person_id"
      ],
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "max_size_m": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "type": "array"
        },
        "qualification": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "segments": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "speed_m_s": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "target": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        "vertical_speed_m_s": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "device_id",
        "segments",
        "points",
        "speed_m_s",
        "vertical_speed_m_s",
        "qualification",
        "max_size_m"
      ],
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/Route"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "route"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/Plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan"
}
